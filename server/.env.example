ZADARMA_API_KEY=your_zadarma_key_here
ZADARMA_API_SECRET=your_zadarma_secret_here
PORT=4000
# Only needed for a real deployment — leave unset for local dev (defaults to
# 127.0.0.1, i.e. not reachable off your own machine). Render/most Node
# hosts require the app to listen on all interfaces to route traffic in.
# HOST=0.0.0.0
# Only needed for a real deployment — comma-separated list of the frontend
# origin(s) allowed to call this server, e.g. https://crm.yourdomain.com.
# Leave unset for local dev (defaults to the Vite dev server origins).
# ALLOWED_ORIGINS=https://crm.yourdomain.com
# Only needed for a real deployment on a host with an ephemeral filesystem
# (e.g. Render's free tier, which wipes everything the process itself
# wrote on every deploy AND on the free-tier idle-restart) — set this to a
# mounted persistent Disk's path (e.g. /data on Render) so the three
# per-feature SQLite files (linkedin.sqlite, sms-inbox.sqlite,
# table-data.sqlite — see server/src/dataDir.ts) survive a restart instead
# of silently resetting to empty. Leave unset for local dev; defaults to
# writing next to this file (server/), same as before this existed.
# DATA_DIR=/data
# Your own phone number (or a SIP/PBX extension) — click-to-call dials
# this first, then connects you to the destination once you pick up.
# A real number rings your actual phone (e.g. the Zadarma mobile app);
# a bare extension like "100" rings a desk/softphone registered to it.
ZADARMA_CALLER_NUMBER=+37066653965
# PBX internal extension — used as-is (bare, e.g. "100") for the
# /v1/webrtc/get_key/ API call. Must already exist in your Zadarma PBX
# (My Zadarma → PBX → Extensions).
ZADARMA_WEBRTC_SIP=100
# The SAME extension, but in the fully-qualified "{account_id}-{extension}"
# form Zadarma's own embed snippet uses for YOUR_SIP (My Zadarma →
# Settings → Integrations and API → WebRTC widget integration — copy it
# from there, don't guess the account_id prefix). Passing the bare
# extension here instead is what produces a silent integrationDisabled
# error from the widget — confirmed directly with Zadarma support.
ZADARMA_WEBRTC_WIDGET_SIP=488048-100
# Optional — sends outgoing SMS (POST /api/sms/send) under a specific
# verified sender id instead of the account's default sender name. Must
# already be verified in Zadarma's own Sender ID settings (My Zadarma →
# Services → SMS → Sender ID) — an unverified value is rejected by Zadarma,
# not by this server. Leave unset to send under the default sender.
# ZADARMA_SMS_CALLER_ID=

OPENAI_API_KEY=your_openai_key_here

# Email Generator tab (server/src/anthropic.ts) — writes client emails via
# Claude. Get a key at console.anthropic.com (Settings → API Keys).
ANTHROPIC_API_KEY=your_anthropic_key_here

# Speech-to-text (call recordings) — ElevenLabs Scribe, not OpenAI. Switched
# from whisper-1 for Lithuanian accuracy; see server/src/elevenlabs.ts.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Apollo.io — the "Search" tab (people/company lookup + enrichment). Free
# tier's rate limits are tight; a paid plan (verified against a real $59/mo
# account) gets 200 req/min, 6000/hr, 50000/day. People Search and
# Organization Search cost 0 and "1 credit per page" respectively; People
# Enrichment (the endpoint that actually returns email/phone) costs 1-9
# credits per person depending on what's found — see server/src/apollo.ts.
# serper.dev — real Google search results for the contact-row Instagram/
# Facebook lookup (🔍 button, SocialLookupModal.tsx). Replaced an earlier
# AI-guessed-URL approach that produced real, reported false results
# (company pages, non-existent profiles) — see server/src/serper.ts's own
# doc comment. Get a key at serper.dev; free tier covers light personal use.
SERPER_API_KEY=your_serper_key_here

APOLLO_API_KEY=your_apollo_key_here

# Instantly tab — cold-email campaigns/leads/mailboxes/Unibox
# (server/src/instantly.ts). Get a key from Instantly's own Settings →
# Integrations → API Keys. Only the workspace this key belongs to is ever
# reachable — connecting a mailbox from the tab uses plain SMTP/IMAP
# credentials (works for any custom-domain mailbox); a Gmail/Outlook
# account added through Instantly's own dashboard (its OAuth flow) just
# shows up here automatically, same workspace, same key.
INSTANTLY_API_KEY=your_instantly_key_here
# Required for the "Find phone" button — Apollo's phone reveal is async
# and needs a real, publicly reachable HTTPS webhook_url (the frontend
# never sees this; the backend fills it in). Also required for the Calls
# tab's "Register SMS webhook" setup action (POST
# /api/zadarma/setup-sms-webhook), which tells Zadarma to POST incoming SMS
# to this same base URL. Set to this deployment's own public base URL —
# e.g. https://api.yourdomain.com — in both server/.env and Render's
# dashboard, even for local testing: for Apollo, the app only relies on
# POLLING the result (pollWebhookResult), never on actually receiving
# Apollo's push at that URL; the Zadarma SMS webhook is the opposite — it's
# a real push receiver (POST /api/zadarma/sms-webhook), so this only works
# end-to-end once actually deployed somewhere Zadarma can reach.
PUBLIC_BASE_URL=https://your-backend-domain.example

# LinkedIn tab (Phase 0) — NOT an official API; Playwright attaches to a
# real, logged-in Chrome over the Chrome DevTools Protocol, so it reuses a
# warm session instead of a fresh automated profile. Launch Chrome yourself
# first with remote debugging enabled, pointed at a SEPARATE profile
# directory (not your default one — current Chrome versions silently
# refuse to open the debug port on your default profile as a security
# measure; no error, it just never listens, which looks identical to
# "Chrome isn't running yet"). The -n matters too: if your regular Chrome
# is already open at all, plain -a just opens a new window in THAT
# instance and silently ignores --args — -n forces a separate process so
# the flags actually apply. Confirmed working on Chrome 151.x:
#   open -na "Google Chrome" --args --remote-debugging-port=9222 --user-data-dir="$HOME/.mydesk-linkedin-chrome-profile"
# That profile starts empty — log into LinkedIn in it once, then keep
# reusing the SAME directory every time so it stays a real, warm,
# persistent session (cookies/history) rather than a fresh one each run.
# Optional — only needed if your debugging port isn't the 9222 default.
# LINKEDIN_CDP_URL=http://127.0.0.1:9222

# Login gate (server/src/auth.ts) — one shared account, required to use
# the app at all once deployed. AUTH_RECOVERY_PASSWORD is a second,
# independent password that also logs you in if you forget the main one;
# there's no in-app "reset" flow that writes anywhere (this host has no
# persistent disk on the free tier), so after logging in with it, update
# AUTH_PASSWORD here (and in Render's dashboard) to something new.
AUTH_USERNAME=your_login_username
AUTH_PASSWORD=your_login_password
AUTH_RECOVERY_PASSWORD=your_recovery_password
# Random signing key for session tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not something you need to remember; just needs to be long/random and
# stay the same across restarts (changing it logs everyone out).
AUTH_TOKEN_SECRET=generate_a_random_64_char_hex_string_here
# Optional, local dev only — skips the login gate (frontend + backend)
# when set to "true" so you don't have to log in on every localhost:5173
# test run. Leave unset here and NEVER set it in Render's dashboard —
# the deployed app must always require login.
AUTH_DISABLED=false

ZADARMA_API_KEY=your_zadarma_key_here
ZADARMA_API_SECRET=your_zadarma_secret_here
PORT=4000
# Only needed for a real deployment — leave unset for local dev (defaults to
# 127.0.0.1, i.e. not reachable off your own machine). Render/most Node
# hosts require the app to listen on all interfaces to route traffic in.
# HOST=0.0.0.0
# Only needed for a real deployment — comma-separated list of the frontend
# origin(s) allowed to call this server, e.g. https://crm.yourdomain.com.
# Leave unset for local dev (defaults to the Vite dev server origins).
# ALLOWED_ORIGINS=https://crm.yourdomain.com
# Your own phone number (or a SIP/PBX extension) — click-to-call dials
# this first, then connects you to the destination once you pick up.
# A real number rings your actual phone (e.g. the Zadarma mobile app);
# a bare extension like "100" rings a desk/softphone registered to it.
ZADARMA_CALLER_NUMBER=+37066653965
# PBX internal extension the browser softphone widget registers as (see
# CLAUDE.md's "Browser softphone" section) — must already exist in your
# Zadarma PBX (My Zadarma → PBX → Extensions).
ZADARMA_WEBRTC_SIP=100

OPENAI_API_KEY=your_openai_key_here

# Speech-to-text (call recordings) — ElevenLabs Scribe, not OpenAI. Switched
# from whisper-1 for Lithuanian accuracy; see server/src/elevenlabs.ts.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

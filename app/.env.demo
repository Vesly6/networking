# Loaded automatically by `vite build --mode demo` (see build-with-demo.sh
# and vite.config.ts). Flips db.ts/useAuthStore.ts/localApi.ts over to the
# in-memory demo data path — see utils/demoMode.ts. Never set in the real
# app.irms.io build, and VITE_API_BASE_URL is deliberately left unset here
# since demo mode never calls it.
VITE_DEMO_MODE=true
